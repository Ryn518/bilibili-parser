# 复制为 .env 并修改（.env 不会提交到 Git）
# 本地开发：npm run dev
# Vercel 部署：在 Project Settings → Environment Variables 中配置以下变量

# 管理员账号 — 仅存在于服务端，勿写入前端代码
ADMIN_USER=your_admin_username
ADMIN_PASS=请改成强密码

# 会话签名密钥 — 至少 16 位随机字符串，切勿泄露
# 可运行: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=请改成随机长字符串

# 可选：用户反馈推送到微信（PushPlus）
# 1. 打开 https://www.pushplus.plus 注册并绑定微信
# 2. 复制「一对一推送」的 token 填到下面
# 3. 有人留言时，微信会收到通知，手机随时可看
FEEDBACK_PUSHPLUS_TOKEN=

# 云同步数据库（Supabase PostgreSQL 连接串）
# 配置后支持：跨设备登录 + 课程/进度云同步
# 1. 打开 https://supabase.com 创建免费项目
# 2. Settings → Database → Connection string → URI（Transaction pooler 推荐）
# 3. 将 DATABASE_URL 填入 Vercel 环境变量并 Redeploy
# 示例：postgresql://postgres.xxxx:password@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres
DATABASE_URL=
